<%- include('partials/head', { title: 'Review Sections - ' + game.name }) %>

<p><a href="/games/<%= game.id %>/base-rules/paste">&larr; Paste different text</a></p>
<h1>Review Parsed Sections</h1>
<p class="hint">Edit titles/text as needed, remove any junk sections, then save. Blank titles are skipped.</p>

<% if (sections.length === 0) { %>
  <p class="empty">Couldn't detect any sections. Try pasting again, or <a href="/games/<%= game.id %>">add rules manually</a> on the game page.</p>
<% } else { %>
<form method="POST" action="/games/<%= game.id %>/base-rules/save" class="form-card">
  <% sections.forEach((s, i) => { %>
    <div class="section-edit">
      <input type="text" name="titles" value="<%= s.title %>">
      <textarea name="bodies" rows="6"><%= s.body %></textarea>
    </div>
  <% }) %>
  <button type="submit" class="btn">Save All Sections</button>
</form>
<% } %>

<%- include('partials/foot') %>

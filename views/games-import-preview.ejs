<%- include('partials/head', { title: 'Review Import' }) %>

<p><a href="/games/import">&larr; Try a different file</a></p>
<h1>Review Import</h1>

<% if (headerError) { %>
  <p class="error"><%= headerError %></p>
  <p><a href="/games/import" class="btn">Back</a></p>
<% } else if (games.length === 0) { %>
  <p class="empty">No rows found below the header. Nothing to import.</p>
<% } else { %>

  <p class="hint">
    <%= games.length %> row<%= games.length === 1 ? '' : 's' %> found.
    Rows with a problem are unchecked and highlighted, fix them or leave them out.
    Edit anything inline, then save.
  </p>

  <form method="POST" action="/games/import/save" class="import-preview-form">
    <div class="import-table-wrap">
      <table class="import-table">
        <thead>
          <tr>
            <th>Add?</th>
            <th>Row</th>
            <th>Name</th>
            <th>Publisher</th>
            <th>Genre</th>
            <th>Min</th>
            <th>Max</th>
            <th>Minutes</th>
            <th>Box art URL</th>
            <th>Notes</th>
          </tr>
        </thead>
        <tbody>
          <% games.forEach((g, i) => { %>
            <tr class="<%= g.errors.length ? 'row-error' : '' %>">
              <td>
                <input type="checkbox" name="include" value="<%= i %>" <%= g.errors.length ? '' : 'checked' %>>
              </td>
              <td class="row-num">
                <%= g.row_number %>
                <% if (g.errors.length) { %><div class="row-error-msg"><%= g.errors.join(', ') %></div><% } %>
              </td>
              <td><input type="text" name="name" value="<%= g.name %>"></td>
              <td><input type="text" name="publisher" value="<%= g.publisher %>"></td>
              <td><input type="text" name="genre" value="<%= g.genre %>"></td>
              <td><input type="number" name="min_players" value="<%= g.min_players ?? '' %>" class="narrow"></td>
              <td><input type="number" name="max_players" value="<%= g.max_players ?? '' %>" class="narrow"></td>
              <td><input type="number" name="play_time_minutes" value="<%= g.play_time_minutes ?? '' %>" class="narrow"></td>
              <td><input type="url" name="cover_image_url" value="<%= g.cover_image_url %>"></td>
              <td><input type="text" name="notes" value="<%= g.notes %>"></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <button type="submit" class="btn">Save Checked Games</button>
  </form>

<% } %>

<%- include('partials/foot') %>

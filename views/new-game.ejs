<%- include('partials/head', { title: 'Add Game' }) %>

<h1>Add a Game</h1>

<form method="POST" action="/games" class="form-card">
  <label class="checkbox-label">
    <input type="checkbox" name="owned" <%= defaultOwned ? 'checked' : '' %>>
    I own this (uncheck to add to the Wishlist instead)
  </label>
  <label>Name<input type="text" name="name" required></label>
  <label>Publisher<input type="text" name="publisher"></label>
  <label>Genre
    <input type="text" name="genre" list="genre-suggestions" placeholder="e.g. Strategy, Party, Cooperative">
    <datalist id="genre-suggestions">
      <option value="Strategy"><option value="Party"><option value="Cooperative">
      <option value="Card Game"><option value="Family"><option value="Worker Placement">
      <option value="Deck Building"><option value="Tile Laying">
    </datalist>
  </label>
  <div class="row">
    <label>Min players<input type="number" name="min_players" min="1"></label>
    <label>Max players<input type="number" name="max_players" min="1"></label>
  </div>
  <label>Play time (minutes)<input type="number" name="play_time_minutes" min="1" placeholder="e.g. 90"></label>
  <label>Category (optional)
    <select name="category_id">
      <option value="">-- None --</option>
      <% categoryOptions.forEach(c => { %>
        <option value="<%= c.id %>"><%= c.indent %><%= c.name %></option>
      <% }) %>
    </select>
    <a href="/categories" class="hint">Manage categories</a>
  </label>
  <label>Box art URL
    <input type="url" name="cover_image_url" placeholder="https://... (paste a link from BGG or Google Images)">
  </label>
  <label>Notes<textarea name="notes" rows="3"></textarea></label>
  <button type="submit" class="btn">Add Game</button>
</form>

<%- include('partials/foot') %>

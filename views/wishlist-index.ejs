<%- include('partials/head', { title: 'Wishlist' }) %>

<h1>Wishlist</h1>
<p class="hint">Games you don't own yet - same everything (rules, expansions, house rules) as an owned game, just tagged not-owned. Mark one owned from its own page whenever you actually get it.</p>

<% if (isAdmin) { %>
<p>
  <a href="/games/new?owned=false" class="btn">+ Add to Wishlist</a>
  <a href="/games/import" class="btn btn-secondary">Import from CSV</a>
</p>
<% } %>

<% if (wishlistGames.length === 0) { %>
  <p class="empty">Nothing on the wishlist yet.</p>
<% } else { %>
  <div class="game-grid">
    <% wishlistGames.forEach(g => { %>
      <a class="game-card" href="/games/<%= g.id %>">
        <% if (g.cover_image_url) { %>
          <img class="box-art-thumb" src="<%= g.cover_image_url %>" alt="<%= g.name %> box art">
        <% } else { %>
          <div class="box-art-thumb box-art-placeholder">🎲</div>
        <% } %>
        <h2><%= g.name %></h2>
        <p class="meta">
          <% if (g.genre) { %><%= g.genre %><% } %>
          <% if (g.min_players || g.max_players) { %> &middot; <%= g.min_players || '?' %>-<%= g.max_players || '?' %> players<% } %>
          <% if (g.play_time_minutes) { %> &middot; <%= g.play_time_minutes %> min<% } %>
          <% if (g.expansion_count > 0) { %> &middot; <%= g.expansion_count %> expansion<%= g.expansion_count === 1 ? '' : 's' %><% } %>
        </p>
        <% if (g.category_path) { %><p class="meta category-path-line">📁 <%= g.category_path %></p><% } %>
      </a>
    <% }) %>
  </div>
<% } %>

<% if (wishlistExpansions.length > 0) { %>
  <h2 style="margin-top:32px;">Expansions</h2>
  <p class="hint">Expansions you want for games you already have (or are also wishlisting).</p>
  <div class="session-history-list">
    <% wishlistExpansions.forEach(exp => { %>
      <a class="session-history-card" href="/games/<%= exp.game_id %>#tab-expansions">
        <div>
          <strong><%= exp.name %></strong>
          <div class="hint">for <%= exp.game_name %><% if (exp.play_time_minutes) { %> &middot; <%= exp.play_time_minutes %> min<% } %></div>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include('partials/foot') %>

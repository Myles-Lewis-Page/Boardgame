<%- include('partials/head', { title: 'Import Games' }) %>

<p><a href="/games">&larr; All games</a></p>
<h1>Import Games</h1>
<p class="hint">
  Upload or paste a CSV to add many games at once. Columns:
  <code>name, publisher, genre, min_players, max_players, play_time_minutes, cover_image_url, notes, rules_text, expansion_of</code>
  &mdash; only <code>name</code> is required, leave the rest blank if you don't have it.
</p>
<p class="hint">
  <code>rules_text</code> is optional: paste the full rulebook text for that game (wrap it in double quotes
  in the CSV so line breaks survive) and it'll be auto-split into rule sections the same way the
  "Paste Rulebook Text" feature does.
</p>
<p class="hint">
  <code>expansion_of</code> is optional: put the exact name of the parent game to add that row as an
  expansion instead of a standalone game. The parent can already exist in your collection, or be another
  row earlier or later in the same file, either works. Leave it blank for a standalone game.
</p>
<p class="hint">
  <code>category_path</code> is optional: put a category path like <code>Strategy &gt; Deck Building &gt; Dice-Driven</code>
  (up to 4 levels, separated by <code>&gt;</code>) and any levels that don't exist yet are created automatically.
  Leave it blank for no category. You'll get a preview to fix anything before it's saved.
</p>
<p><a href="/games/import/template" class="btn btn-small btn-secondary">Download starter template.csv</a></p>

<form method="POST" action="/games/import/preview" class="form-card" id="import-form">
  <label>Upload a CSV file
    <input type="file" id="csv-file-input" accept=".csv,text/csv">
  </label>
  <label>...or paste CSV text here
    <textarea name="rawCsv" id="raw-csv" rows="14" placeholder="name,publisher,genre,min_players,max_players,play_time_minutes,cover_image_url,notes
Catan,Kosmos,Strategy,3,4,90,,
Dominion,,Deck Building,2,4,45,,"></textarea>
  </label>
  <button type="submit" class="btn">Preview Import</button>
</form>

<script>
  document.getElementById('csv-file-input').addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      document.getElementById('raw-csv').value = reader.result;
    };
    reader.readAsText(file);
  });
</script>

<%- include('partials/foot') %>

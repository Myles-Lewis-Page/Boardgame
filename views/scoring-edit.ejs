<%- include('partials/head', { title: 'Scoring setup - ' + game.name }) %>

<p><a href="/games/<%= game.id %>">&larr; <%= game.name %></a></p>

<h1>Scoring setup</h1>
<p class="hint">Build the scoresheet for <strong><%= game.name %></strong>. Add one row per thing that gets scored. Use "Group label" to add a bold subheader above a row (like "1 point each") - it's just for grouping, it doesn't affect the math.</p>

<% if (categories.length === 0) { %>
  <p class="empty">No categories yet - add your first one below.</p>
<% } else { %>
<div class="score-cat-list">
  <% let lastGroup = null; %>
  <% categories.forEach((c, i) => { %>
    <% if (c.group_label !== lastGroup) { %>
      <div class="score-cat-group-header"><%= c.group_label || '' %></div>
      <% lastGroup = c.group_label; %>
    <% } %>
    <div class="score-cat-row">
      <div class="score-cat-info">
        <strong><%= c.label %></strong>
        <span class="hint">
          <% if (c.is_multiplier) { %>
            enter a count &times; <%= c.multiplier_value %> pt<%= c.multiplier_value == 1 ? '' : 's' %> each
          <% } else { %>
            enter points directly
          <% } %>
        </span>
      </div>
      <div class="score-cat-actions">
        <form method="POST" action="/games/<%= game.id %>/scoring/categories/<%= c.id %>/move" class="inline-form">
          <input type="hidden" name="direction" value="up">
          <button type="submit" class="btn btn-tiny btn-secondary" <%= i === 0 ? 'disabled' : '' %>>&uarr;</button>
        </form>
        <form method="POST" action="/games/<%= game.id %>/scoring/categories/<%= c.id %>/move" class="inline-form">
          <input type="hidden" name="direction" value="down">
          <button type="submit" class="btn btn-tiny btn-secondary" <%= i === categories.length - 1 ? 'disabled' : '' %>>&darr;</button>
        </form>
        <form method="POST" action="/games/<%= game.id %>/scoring/categories/<%= c.id %>/delete" class="inline-form" onsubmit="return confirm('Remove this scoring row? Past game history that used it will lose those numbers.')">
          <button type="submit" class="btn btn-tiny btn-danger">Remove</button>
        </form>
      </div>
    </div>
  <% }) %>
</div>
<% } %>

<div class="form-card">
  <h3>Add a scoring row</h3>
  <form method="POST" action="/games/<%= game.id %>/scoring/categories">
    <label>Label
      <input type="text" name="label" placeholder="e.g. Birds, Bonus cards, Eggs" required>
    </label>
    <label>Group label (optional)
      <input type="text" name="group_label" placeholder="e.g. 1 point each">
    </label>
    <label class="checkbox-label">
      <input type="checkbox" name="is_multiplier" id="is-multiplier-check">
      Score this by count &times; a fixed point value (instead of typing points directly)
    </label>
    <label id="multiplier-value-label" class="hidden">Points per item
      <input type="number" name="multiplier_value" step="any" value="1">
    </label>
    <button type="submit" class="btn">+ Add Row</button>
  </form>
</div>

<script>
  const checkbox = document.getElementById('is-multiplier-check');
  const wrap = document.getElementById('multiplier-value-label');
  checkbox.addEventListener('change', () => wrap.classList.toggle('hidden', !checkbox.checked));
</script>

<%- include('partials/foot') %>

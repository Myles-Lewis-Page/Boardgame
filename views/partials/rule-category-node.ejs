<%
  // locals expected: node (category with .children), sectionsByCategory (Map id -> sections array),
  // isAdmin, gameId, sourceKey
  const secsHere = sectionsByCategory.get(node.id) || [];
%>
<div class="rule-category-block" data-source="<%= sourceKey %>" style="margin-left: <%= (node.depth - 1) * 16 %>px" id="rulecat-<%= node.id %>">
  <h4 class="rule-category-header"><%= node.name %></h4>
  <% secsHere.forEach(s => { %>
    <%- include('rule-section-card', { s, isAdmin, gameId, sourceKey }) %>
  <% }) %>
  <% node.children.forEach(child => { %>
    <%- include('rule-category-node', { node: child, sectionsByCategory, isAdmin, gameId, sourceKey }) %>
  <% }) %>
</div>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Board Game Rules' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="topbar">
    <a href="/games" class="brand">Board Game Rules</a>
    <div class="topbar-actions">
      <a href="/games" class="btn btn-small btn-secondary">My Games</a>
      <a href="/expansions" class="btn btn-small btn-secondary">My Expansions</a>
      <a href="/wishlist" class="btn btn-small btn-secondary">Wishlist Games</a>
      <a href="/expansions/wishlist" class="btn btn-small btn-secondary">Wishlist Expansions</a>
      <a href="/randomizer" class="btn btn-small btn-secondary">What Should We Play?</a>
      <% if (locals.isAdmin) { %>
        <a href="/games/import" class="btn btn-small btn-secondary">Import</a>
        <a href="/games/new" class="btn btn-small">+ Add Game</a>
        <form method="POST" action="/logout" class="inline-form">
          <button type="submit" class="btn btn-small btn-secondary">Log Out</button>
        </form>
      <% } else { %>
        <a href="/login" class="btn btn-small btn-secondary">Login</a>
      <% } %>
    </div>
  </header>
  <main class="container">

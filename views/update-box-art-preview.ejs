<%- include('partials/head', { title: 'Review Box Art' }) %>

<p><a href="/games/update-box-art">&larr; Try a different file</a></p>
<h1>Review Box Art</h1>

<% if (headerError) { %>
  <p class="error"><%= headerError %></p>
  <p><a href="/games/update-box-art" class="btn">Back</a></p>
<% } else if (rows.length === 0) { %>
  <p class="empty">No rows found. Nothing to update.</p>
<% } else { %>

  <p class="hint">
    <%= rows.length %> row<%= rows.length === 1 ? '' : 's' %> found. Rows that couldn't be matched are
    unchecked and highlighted.
  </p>

  <form method="POST" action="/games/update-box-art/save">
    <% rows.forEach((r, i) => { %>
      <div class="import-row-card <%= r.found ? '' : 'row-error' %>">
        <div class="import-row-header">
          <label class="import-include">
            <input type="checkbox" name="include" value="<%= i %>" <%= r.found ? 'checked' : '' %>>
            Row <%= r.row_number %>
          </label>
          <% if (!r.found) { %><span class="row-error-msg">No game or expansion named "<%= r.game_name %>" found</span><% } %>
          <% if (r.found) { %><span class="badge"><%= r.matchType %></span><% } %>
        </div>
        <div class="import-row-fields">
          <label class="span-3">Name<input type="text" value="<%= r.game_name %>" readonly></label>
          <label class="span-3">New box art URL<input type="url" name="cover_image_url" value="<%= r.cover_image_url %>"></label>
        </div>
        <% if (r.currentUrl) { %><img src="<%= r.currentUrl %>" alt="current art" class="box-art-preview-thumb"><% } %>
        <input type="hidden" name="game_name" value="<%= r.game_name %>">
        <input type="hidden" name="match_type" value="<%= r.matchType || '' %>">
        <input type="hidden" name="match_id" value="<%= r.matchId || '' %>">
      </div>
    <% }) %>
    <button type="submit" class="btn">Apply Box Art</button>
  </form>

<% } %>

<%- include('partials/foot') %>

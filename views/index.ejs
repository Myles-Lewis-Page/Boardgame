<%- include('partials/head', { title: 'My Games' }) %>

<h1>My Games</h1>

<% if (games.length === 0) { %>
  <p class="empty">No games yet. <a href="/games/new">Add your first one</a>.</p>
<% } else { %>
  <div class="game-grid">
    <% games.forEach(g => { %>
      <a class="game-card" href="/games/<%= g.id %>">
        <h2><%= g.name %></h2>
        <p class="meta">
          <% if (g.publisher) { %><%= g.publisher %><% } %>
          <% if (g.min_players || g.max_players) { %>
            &middot; <%= g.min_players || '?' %>-<%= g.max_players || '?' %> players
          <% } %>
          <% if (g.play_time) { %> &middot; <%= g.play_time %><% } %>
        </p>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include('partials/foot') %>
